    "src/lib/form-security.ts",
    "src/lib/i18n.ts",
    "src/types/site.ts",
    "src/lib/http-body.ts",
    "src/lib/submission-policy.ts",
    "src/lib/pdf-policy.ts",
    "src/lib/civil-date.ts",
    "src/lib/showcase-validation.ts",
    "src/lib/reliable-submission.ts",
    "src/lib/review-validation.ts",
    "src/lib/contact-client.ts",
    "src/lib/turnstile-client.ts",
    "src/lib/estate-state.ts",
    "src/lib/pagination.ts",
    "src/lib/preview-target.ts"
  ]
}
