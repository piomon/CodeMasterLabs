{
  "name": "codemaster-studio",
  "version": "2.3.0-functional",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "npm run setup",
    "dev": "next dev --webpack",
    "prebuild": "npm run setup",
    "build": "next build --webpack",
    "start": "node --import ./docker/production-preflight.mjs .next/standalone/server.js",
    "lint": "eslint src scripts --ext .ts,.tsx,.mjs,.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "create-admin": "node scripts/operator.mjs create-admin",
    "seed": "node scripts/operator.mjs seed",
    "cleanup": "node scripts/operator.mjs cleanup",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "check:source": "node scripts/check-source.cjs",
    "docker:bootstrap": "tsx scripts/docker-bootstrap.ts",
    "db:init": "tsx scripts/init-database.ts",
    "check:deployment": "node scripts/operator.mjs check-deployment",
    "migrations:prepare": "node scripts/prepare-migrations.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "typecheck:domain": "tsc --project tsconfig.domain.json",
    "resolve:lock": "node scripts/resolve-lock.mjs",
    "payload": "payload",
    "verify:static": "node scripts/check-source.cjs && node --test tests/*.test.cjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "notifications": "node scripts/operator.mjs notifications",
    "audit:local": "python3 scripts/verify-local.py",
    "verify:functional": "node scripts/verify-functional.mjs",
    "test:browser:isolated": "python3 tests/browser-isolated/run.py"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@types/three": "^0.186.0",
    "graphql": "^16.11.0",
    "next": "16.3.7",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "nodemailer": "10.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "@axe-core/playwright": "^4.11.0"
  },
  "overrides": {
    "nodemailer": "10.0.12",
    "undici": "7.30.0",
    "esbuild": "0.25.12"
  }
}
